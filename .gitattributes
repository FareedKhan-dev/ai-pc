# Line endings: LF in the repository and in every checkout, whatever the machine's settings,
# except for Windows scripts that need CRLF.
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never converted or diffed as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.pptx binary
*.mp3  binary
*.mp4  binary
*.wav  binary
*.zip  binary
*.whl  binary
