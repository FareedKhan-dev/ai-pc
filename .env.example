# Copy this file to .env (git-ignored) and fill in what you use, or keep keys in the encrypted vault instead:
#   ai-pc keys set NEBIUS_API_KEY
# Keys are read from the environment first, then .env, then the vault. They are never logged or sent to a model.

# The language model provider (Nebius Token Factory, OpenAI-compatible)
NEBIUS_API_KEY=

# Optional: keep the project's data (tools, models, media, outputs, state) in another folder
# AI_PC_HOME=D:\ai-pc-data

# Optional: the click model for the desktop agent's vision lane (vocaela or tinyclick)
# CUA_GROUNDER=vocaela
